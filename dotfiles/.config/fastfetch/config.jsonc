{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/odyssey.txt",
        "type": "file",
        "width": 20,
        "height": 13,
        "color": { "1": "red" },
        "padding": { "right": 2 }
    },
    "modules": [
        "title", "separator", "os", "host", "kernel",
        "uptime", "packages", "shell", "de", "wm",
        "cpu", "memory", "colors"
    ]
}
