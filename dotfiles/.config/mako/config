# Odyssey — mako notification daemon

# Font
font=JetBrains Mono Nerd Font 10

# Palette Odyssey
background-color=#0a0a0a
text-color=#eaeaea
border-color=#e8192c
progress-color=over #e8192c

# Forma — angoli vivi, bordo rosso firma
border-size=2
border-radius=0
padding=12
margin=8

# Dimensioni
width=340
height=120
icons=1
max-icon-size=48

# Posizione: in alto a destra
anchor=top-right
default-timeout=5000
layer=overlay

# Notifica urgente: bordo più spesso
[urgency=high]
border-color=#e8192c
border-size=3
default-timeout=0

# Notifica bassa priorità: bordo grigio
[urgency=low]
border-color=#5a5a5a
