/*****----- Tema Odyssey: power menu -----*****/
configuration {
    show-icons: false;
}

* {
    font:             "JetBrains Mono 12";
    background-color: #0a0a0a;
    text-color:       #eaeaea;
}

window {
    width: 240px;
    border: 1px;
    border-color: #eaeaea;
    padding: 10px;
    background-color: #0a0a0a;
    location: center;
    anchor:   center;
}

mainbox {
    spacing: 8px;
    children: [ inputbar, listview ];
}

inputbar {
    padding: 4px 10px;
    background-color: #e8192c;
    children: [ prompt ];
}

prompt {
    text-color: #ffffff;
    background-color: inherit;
}

listview {
    border: 0;
    spacing: 2px;
    scrollbar: false;
    lines: 4;
    dynamic: true;
}

element {
    padding: 8px 14px;
    background-color: #0a0a0a;
    text-color:       #eaeaea;
}

element selected {
    background-color: #e8192c;
    text-color:       #ffffff;
}

element-text {
    background-color: inherit;
    text-color:       inherit;
    vertical-align:   0.5;
}
